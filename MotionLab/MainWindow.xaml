<Window x:Class="MotionLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="MotionLab" Height="700" Width="1000" MinHeight="500" MinWidth="800"
        Background="#F5F5F5" Foreground="Black">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header / Title -->
        <TextBlock Text="MotionLab Instrumentation Prototype" FontSize="20" FontWeight="SemiBold" 
                   Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,0,20"/>

        <!-- Left Panel: Config and Results -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
            <StackPanel>
            <GroupBox Header="Test Configuration">
                <StackPanel>
                    <TextBlock Text="Surface Type"/>
                    <ComboBox SelectedValue="{Binding CurrentConfig.Surface}" SelectedValuePath="Content">
                        <ComboBoxItem Content="Wooden Desk"/>
                        <ComboBoxItem Content="Mouse Mat"/>
                        <ComboBoxItem Content="Paper"/>
                        <ComboBoxItem Content="Cardboard"/>
                        <ComboBoxItem Content="Fabric"/>
                    </ComboBox>

                    <TextBlock Text="Test Mode"/>
                    <ComboBox SelectedValue="{Binding CurrentConfig.TestMode}" SelectedValuePath="Content">
                        <ComboBoxItem Content="Motion Test"/>
                        <ComboBoxItem Content="Repeatability Test"/>
                    </ComboBox>

                    <TextBlock Text="Sampling Interval (ms)"/>
                    <TextBox Text="{Binding CurrentConfig.SamplingIntervalMs}"/>

                    <TextBlock Text="Calibration Factor (units/mm)"/>
                    <TextBox Text="{Binding CurrentConfig.CalibrationFactor}"/>

                    <TextBlock Text="Smoothing Window (samples)"/>
                    <TextBox Text="{Binding CurrentConfig.SmoothingWindowSize}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Test Controls">
                <WrapPanel>
                    <Button Content="Start Test" Command="{Binding StartTestCommand}"/>
                    <Button Content="Stop Test" Command="{Binding StopTestCommand}"/>
                    <Button Content="Export CSV/JSON" Command="{Binding ExportCommand}"/>
                    <Button Content="Delete Selected" Command="{Binding DeleteSelectedTestCommand}"/>
                    <Button Content="Clear All Tests" Command="{Binding ClearAllTestsCommand}"/>
                </WrapPanel>
            </GroupBox>
            
            <GroupBox Header="Calibration Tools">
                <WrapPanel>
                    <Button Content="Run 150mm Auto-Calibration" Command="{Binding StartCalibrationCommand}"/>
                </WrapPanel>
            </GroupBox>
            
            <GroupBox Header="Current State">
                <StackPanel>
                    <TextBlock Text="{Binding TestState, StringFormat='State: {0}'}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentDuration, StringFormat='Duration: {0:mm\\:ss\\.ff}'}"/>
                    <TextBlock Text="{Binding CurrentSampleCount, StringFormat='Samples: {0}'}"/>
                    <TextBlock Text="{Binding CurrentDisplacement, StringFormat='Displacement: {0:F2}'}"/>
                    <TextBlock Text="{Binding CurrentVelocity, StringFormat='Velocity: {0:F2}'}"/>
                </StackPanel>
            </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Right Panel: Graph and History -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <!-- Chart -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" Grid.Row="0" Margin="0,0,0,10">
                <oxy:PlotView Model="{Binding LivePlotModel}" Background="White" Foreground="Black"/>
            </Border>

            <!-- History Table -->
            <GroupBox Header="Test History" Grid.Row="1" Margin="0">
                <DataGrid ItemsSource="{Binding TestHistory}" AutoGenerateColumns="False" 
                          SelectedItem="{Binding SelectedTestResult, Mode=TwoWay}"
                          IsReadOnly="True" Background="White" RowBackground="White" 
                          AlternatingRowBackground="#F9F9F9" Foreground="Black"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Surface" Binding="{Binding Surface}" Width="100"/>
                        <DataGridTextColumn Header="Mode" Binding="{Binding TestMode}" Width="120"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration, StringFormat={}{0:mm\\:ss}}" Width="80"/>
                        <DataGridTextColumn Header="Samples" Binding="{Binding SampleCount}" Width="80"/>
                        <DataGridTextColumn Header="Total Disp" Binding="{Binding TotalDisplacement, StringFormat={}{0:F2}}" Width="100"/>
                        <DataGridTextColumn Header="Mean Vel" Binding="{Binding MeanVelocity, StringFormat={}{0:F2}}" Width="100"/>
                        <DataGridTextColumn Header="Stick-Slip" Binding="{Binding StickSlipEventCount}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
